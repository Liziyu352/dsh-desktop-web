{
  "name": "@liziyu352/dsh-desktop-web",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Starts `dsh web` once at DeepSeek Harness Desktop startup and records the authenticated URL.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "desktop",
    "web"
  ],
  "homepage": "https://github.com/Liziyu352/dsh-desktop-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Liziyu352/dsh-desktop-web.git"
  },
  "bugs": {
    "url": "https://github.com/Liziyu352/dsh-desktop-web/issues"
  },
  "author": "Liziyu352",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README-en-us.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
